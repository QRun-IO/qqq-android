<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
   <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
   <application>
      <activity android:name="net.openid.appauth.RedirectUriReceiverActivity" tools:node="remove" />
      <activity android:name="com.kingsrook.qqq.frontend.android.mobileapp.ui.authentication.OAuth2RedirectActivity"
            android:exported="true" android:excludeFromRecents="true">
         <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="${applicationId}.oauth" android:host="callback" android:path="/oauth2redirect" />
         </intent-filter>
      </activity>
   </application>
</manifest>
